# ---------------------------------------------------------------------------
# WorldView environment. Copy to .env.local and fill in what you need.
# Every variable is optional — the app runs on keyless public feeds by default.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Product name shown in the UI (public)
NEXT_PUBLIC_APP_NAME=WorldView

# "live" ingests real public data. "demo" shows ONLY clearly-labelled simulated
# events (useful offline). The two modes use separate local stores.
WORLDVIEW_DATA_MODE=live

# Set to false to serve stored data without polling upstream feeds.
INGESTION_ENABLED=true

# Local store location and retention (days)
DATA_DIR=.data
RETENTION_DAYS=8

# Optional contact appended to the User-Agent (api.weather.gov asks for one), e.g. you@example.com
WORLDVIEW_CONTACT=

# Optional. When set, POST /api/ingest/:source requires "Authorization: Bearer <token>".
# When unset, manual ingestion is only allowed from localhost.
ADMIN_TOKEN=

# Optional NASA FIRMS MAP_KEY (free: https://firms.modaps.eosdis.nasa.gov/api/map_key/).
# Without it the public 24-hour VIIRS file is used.
NASA_FIRMS_MAP_KEY=

# Optional live layers (map modes). Aviation works without credentials (anonymous
# OpenSky quota); an OpenSky API client raises limits.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Maritime mode needs a free key from https://aisstream.io
AISSTREAM_API_KEY=

# Optional AI interpretation (clearly labelled, never presented as fact).
# AI_PROVIDER: anthropic | none
AI_PROVIDER=none
AI_API_KEY=
# Defaults to claude-opus-5-5 when empty
AI_MODEL=

# Storage. Unset = in-memory store with a JSON snapshot in DATA_DIR (default).
#   DATABASE_URL=pglite                      embedded Postgres (no install) in DATA_DIR/pglite-<mode>
#   DATABASE_URL=postgres://user:pass@host:5432/db   PostgreSQL server (schema worldview_<mode>)
DATABASE_URL=
