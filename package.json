{
  "name": "worldview",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "geo:build": "tsx scripts/build-geo-data.ts",
    "ai:setup": "node-llama-cpp pull --dir .data/models hf:unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M",
    "briefing:morning": "NODE_OPTIONS=--conditions=react-server tsx scripts/morning-briefing.ts",
    "briefing:schedule": "node scripts/schedule-briefing.mjs",
    "briefing:unschedule": "node scripts/schedule-briefing.mjs --remove"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@electric-sql/pglite": "^0.5.8",
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "maplibre-gl": "^6.12.0",
    "next": "16.3.8",
    "node-llama-cpp": "^3.22.1",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
