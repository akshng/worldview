{
  "name": "worldview",
  "version": "0.1.0",
  "description": "3D globe of real-world events from keyless public feeds",
  "author": "akshng (https://github.com/akshng)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/akshng/worldview.git"
  },
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "geo:build": "tsx scripts/build-geo-data.ts",
    "ai:setup": "node-llama-cpp pull --dir .data/models hf:unsloth/gemma-4-E2B-it-GGUF:Q4_K_M",
    "briefing:morning": "node --conditions=react-server --import tsx scripts/morning-briefing.ts",
    "briefing:schedule": "node scripts/schedule-briefing.mjs",
    "briefing:unschedule": "node scripts/schedule-briefing.mjs --remove",
    "service:install": "node scripts/local-service.mjs install",
    "service:restart": "node scripts/local-service.mjs restart",
    "service:uninstall": "node scripts/local-service.mjs uninstall",
    "geo:regions": "tsx scripts/build-regions.ts",
    "geo:infra": "tsx scripts/build-infra.ts",
    "discord:test": "tsx scripts/discord-test.mts",
    "close:run": "node --conditions=react-server --import tsx scripts/market-close.ts",
    "close:schedule": "node scripts/schedule-briefing.mjs --close",
    "close:unschedule": "node scripts/schedule-briefing.mjs --close --remove",
    "windows:schedule": "node scripts/schedule-windows.mjs install",
    "windows:unschedule": "node scripts/schedule-windows.mjs remove",
    "sentinel": "node --conditions=react-server --import tsx scripts/sentinel.ts",
    "power:install": "node scripts/power-mode.mjs install",
    "power:uninstall": "node scripts/power-mode.mjs uninstall",
    "app": "node scripts/power-mode.mjs app",
    "mac:build": "sh scripts/build-mac-app.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@electric-sql/pglite": "^0.5.8",
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "hls.js": "^1.7.3",
    "maplibre-gl": "^6.12.0",
    "next": "^16.4.6",
    "node-llama-cpp": "^3.22.2",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
